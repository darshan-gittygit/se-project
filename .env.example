# Copy this file to .env and fill in your actual key.
# Never commit or share the real .env file.

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: reject API requests without an X-Role header (off by default)
# REQUIRE_ROLE=1
# Optional: delete stored runs older than this many days with `python -m app.retention`
# RETENTION_DAYS=365
